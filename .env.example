# Local Docker Compose development only. Generate real secrets before use.
APP_ENV=development
APP_NAME=drillstock
DB_NAME=drillstock_dev
MONGO_ROOT_USER=drillstock
MONGO_ROOT_PASSWORD=replace-with-a-long-local-only-password
MONGO_URL=mongodb://drillstock:replace-with-a-long-local-only-password@mongo:27017/drillstock_dev?authSource=admin
JWT_SECRET=replace-with-at-least-32-random-characters
ZOHO_TOKEN_KEY=replace-with-a-valid-fernet-key
ADMIN_EMAIL=admin@drillstock.com
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
PUBLIC_APP_URL=http://localhost:8081
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/uploads

# Set both Google client values to enable web Google sign-in.
GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Frontend build configuration. Local browser requests go to the published port.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_ENABLE_DEMO_ACCOUNTS=true
EXPO_PUBLIC_DEMO_DRILLER_EMAIL=jake@drillstock.com
EXPO_PUBLIC_DEMO_DRILLER_PASSWORD=Driller@123
EXPO_PUBLIC_DEMO_MANAGER_EMAIL=qld.manager@drillstock.com
EXPO_PUBLIC_DEMO_MANAGER_PASSWORD=Manager@123
EXPO_PUBLIC_DEMO_ADMIN_EMAIL=admin@drillstock.com
EXPO_PUBLIC_DEMO_ADMIN_PASSWORD=Admin@12345

# Production S3-compatible storage settings. Keep blank for local Compose only.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
