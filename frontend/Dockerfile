FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts ./scripts
RUN npm ci
COPY . .
ARG EXPO_PUBLIC_BACKEND_URL
ARG EXPO_PUBLIC_GOOGLE_CLIENT_ID=
ARG EXPO_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
ARG EXPO_PUBLIC_DEMO_DRILLER_EMAIL=
ARG EXPO_PUBLIC_DEMO_DRILLER_PASSWORD=
ARG EXPO_PUBLIC_DEMO_MANAGER_EMAIL=
ARG EXPO_PUBLIC_DEMO_MANAGER_PASSWORD=
ARG EXPO_PUBLIC_DEMO_ADMIN_EMAIL=
ARG EXPO_PUBLIC_DEMO_ADMIN_PASSWORD=
ENV EXPO_PUBLIC_BACKEND_URL=$EXPO_PUBLIC_BACKEND_URL \
    EXPO_PUBLIC_GOOGLE_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_CLIENT_ID \
    EXPO_PUBLIC_ENABLE_DEMO_ACCOUNTS=$EXPO_PUBLIC_ENABLE_DEMO_ACCOUNTS \
    EXPO_PUBLIC_DEMO_DRILLER_EMAIL=$EXPO_PUBLIC_DEMO_DRILLER_EMAIL \
    EXPO_PUBLIC_DEMO_DRILLER_PASSWORD=$EXPO_PUBLIC_DEMO_DRILLER_PASSWORD \
    EXPO_PUBLIC_DEMO_MANAGER_EMAIL=$EXPO_PUBLIC_DEMO_MANAGER_EMAIL \
    EXPO_PUBLIC_DEMO_MANAGER_PASSWORD=$EXPO_PUBLIC_DEMO_MANAGER_PASSWORD \
    EXPO_PUBLIC_DEMO_ADMIN_EMAIL=$EXPO_PUBLIC_DEMO_ADMIN_EMAIL \
    EXPO_PUBLIC_DEMO_ADMIN_PASSWORD=$EXPO_PUBLIC_DEMO_ADMIN_PASSWORD
RUN npx expo export --platform web --output-dir dist

FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
