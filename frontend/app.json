{
  "expo": {
    "name": "SIS Companion",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.drillstockroom.lgzu43",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan bin QR codes and photograph equipment condition",
        "NSPhotoLibraryUsageDescription": "Attach equipment condition photos from your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C2228"
      },
      "package": "com.emergent.drillstockroom.lgzu43",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "SIS Companion",
      "shortName": "SIS Companion",
      "lang": "en-AU",
      "description": "Warehouse stock, bins and equipment for authorised staff.",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "themeColor": "#1C2228",
      "backgroundColor": "#1C2228"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sis-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C2228"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan bin QR codes and photograph equipment condition"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach equipment condition photos from your library",
          "cameraPermission": "Photograph equipment condition"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
